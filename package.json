{
  "name": "@wwl/wwl-hex-earth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A hex-grid rendering of the whole Earth, built with Vue 3, @vanduo-oss/vd3, and @wwl/wwl-cbun.",
  "license": "MIT",
  "author": "Nostromo-618",
  "homepage": "https://github.com/nostromo-618/wwl-hex-earth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostromo-618/wwl-hex-earth.git"
  },
  "bugs": {
    "url": "https://github.com/nostromo-618/wwl-hex-earth/issues"
  },
  "keywords": [
    "hex",
    "earth",
    "vue",
    "canvas",
    "topojson",
    "wwl"
  ],
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,json,md}\" \".github/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,json,md}\" \".github/**/*.md\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare-land": "node scripts/prepare-land.mjs",
    "knip": "knip",
    "ci": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test:coverage && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@vanduo-oss/vd3": "1.7.5",
    "@wwl/wwl-cbun": "link:../wwl-cbun",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@wwl/wwl-cbun"
    ]
  },
  "exports": {
    ".": "./dist/lib/index.js",
    "./style.css": "./dist/lib/style.css"
  }
}
